{
  "extends": "../../tsconfig.json",
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "Node20",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "target": "ES2019",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "stream": [
        "./node_modules/stream-browserify"
      ],
      "assert": [
        "./node_modules/assert"
      ]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "./dist/**",
    "./gushio/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/cdk.out/**/*"
  ]
}
