{
  "compileOnSave": true,
  "compilerOptions": {
    "strict": false,
    "baseUrl": "./",
    "declaration": false,
    "experimentalDecorators": true,
    "lib": [
      "es2018",
      "dom"
    ],
    "module": "Node20",
    "moduleResolution": "Node16",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": "..",
    "sourceMap": true,
    "target": "ES2022",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "types": [
      "node"
    ],
  },
  "include": ["**/*.ts"]
}
